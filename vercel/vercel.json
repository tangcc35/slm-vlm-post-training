{
  "version": 2,
  "buildCommand": "rm -rf src && mkdir -p src && cp -r ../src/story_rp_engine src/",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "src/story_rp_engine/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
