# Weights & Biases API Key (get from https://wandb.ai/authorize)
WANDB_API_KEY=

# Hugging Face User Access Token (get from https://huggingface.co/settings/tokens)
HF_TOKEN=

# Model Server (llama.cpp)
LLAMA_MODEL_PATH="outputs/Qwen3.5-2B-Uncensored-HauhauCS-Aggressive/Qwen3.5-2B-Uncensored-HauhauCS-Aggressive-Q8_0.gguf"
LLAMA_HOST="127.0.0.1"
LLAMA_PORT="8001"
N_GPU_LAYERS="-1"
N_CTX="4096"

# Google AI Studio API Key (get from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# FastAPI Backend Configuration
HOST="0.0.0.0"
PORT="8000"
# Model identifier for ADK (e.g. gemini-flash-latest, gemini-2.5-flash, gemini-2.0-flash, or openai/qwen3.5-2b)
STORY_RP_MODEL="gemini-flash-latest"
# STORY_RP_API_BASE is for local servers (e.g. llama.cpp/Ollama). Leave commented for Google AI Studio.
# STORY_RP_API_BASE="http://127.0.0.1:8001/v1"

# Arize Phoenix Observability
PHOENIX_ENABLED="true"
PHOENIX_HOST="0.0.0.0"
PHOENIX_PORT="6006"

# Database (Neon Postgres). When set, sessions, characters and lorebooks are stored there;
# when unset, they stay in .engine_data/ (JSON files + SQLite). Paste Neon's pooled
# connection string as-is; on Vercel the Neon integration sets DATABASE_URL for you.
# DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/neondb?sslmode=require&channel_binding=require"
